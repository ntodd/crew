# Pinned inputs of the guest image (docs/crew_spec.md §13.1), except the
# Ubuntu base, the snapshot and the packages: those are in packages.lock.
#
# Sourced by the build scripts and included by the Makefile, so: KEY=value,
# no quotes, no spaces. Bumping any of these is a supply-chain review
# (§20.4); docs/releasing.md lists them.

# The kernel: kernel.org 6.18.y LTS. The tarball's SHA-256 is pinned here,
# and its .sign must verify with one of the keys in kernel/keys/ (pinned by
# fingerprint in KERNEL_SIGNERS).
KERNEL_VERSION=6.18.60
KERNEL_SHA256=3c2f44ef6acc021a7ad444d9a2e6ec1ef488ff09368793d0004a6080f69d621e
# Greg Kroah-Hartman (stable releases) and Linus Torvalds (mainline).
KERNEL_SIGNERS=647F28654894E3BD457199BE38DBBDC86092693E,ABAF11C65A2970B130ABE3C479BE3E4300411886

# moby's contrib/check-config.sh, the kernel check's first half.
MOBY_CHECK_CONFIG_COMMIT=a4c5b2be6f69f86fe7b13eb4822676f8d273cf8b
MOBY_CHECK_CONFIG_SHA256=fda4343e9b50c47896653ca774ccbe9614bfcdb60f080d2b6277baf27efc0a71

# Third-party apt repositories, by key fingerprint. Their package versions
# are pinned in packages.txt and packages.lock.
DOCKER_APT_KEY_FPR=9DC858229FC7DD38854AE2D88D81803C0EBFCD88
PGDG_APT_KEY_FPR=B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8

# actions/runner, from GitHub's release, by SHA-256 per arch.
RUNNER_VERSION=2.338.2
RUNNER_SHA256_arm64=670adb2f268fe21dcbb58b3db0e0aa9d5b3bddfe2c651481336e561ff86de945
RUNNER_SHA256_x64=baebf204307bac6193480852732f0aba2ae97b6c5597c244f4d5558390147c40

# Playwright's browsers, for playwright 1.64.1 (its browsers.json), by
# SHA-256. On arm64 only Chromium (with its headless shell) and ffmpeg.
PLAYWRIGHT_VERSION=1.64.1
PLAYWRIGHT_CHROMIUM_REVISION=1248
PLAYWRIGHT_CHROMIUM_VERSION=156.0.8078.4
PLAYWRIGHT_CHROMIUM_SHA256_arm64=910a12fff6170202195f72ef3d353801c7063d301ab80b1f51b77d791fda60ce
PLAYWRIGHT_HEADLESS_SHELL_SHA256_arm64=81ab9d4d3c301dc5fdfb6c541b9e6632b16fc819a6a854460f40a76fe2b2c476
PLAYWRIGHT_FFMPEG_REVISION=1013
PLAYWRIGHT_FFMPEG_SHA256_arm64=457360e803a7d8d5f8f7f5ecf562b2d338f6b4f7f86339d0c31938a451e8878b

# crew-guest's release is built in this image (Ubuntu noble, so its ERTS
# links against the guest's own libraries). Erlang and Elixir match
# mise.toml.
ELIXIR_IMAGE=hexpm/elixir:1.20.4-erlang-29.1.1-ubuntu-noble-20260917@sha256:d6bafec523f681f19d430ac1e19884022576b19d93e57e0db013633c73385bd2
