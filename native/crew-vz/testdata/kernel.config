# Merged over arm64 defconfig for the crew-vz test guest. Everything the VM
# needs is built in: VZLinuxBootLoader boots with no initrd and no modules.

# Virtualization.framework's devices are virtio over PCIe (ECAM).
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# Root on /dev/vda (ext4), devtmpfs mounted for init.
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ip=<guest>::<gw>:255.255.255.252::eth0:off (§13.3)
CONFIG_IP_PNP=y
# Raw ARP probes from the test init.
CONFIG_PACKET=y
# Left on so the guest emits IPv6 (DAD, router solicitations) for the
# helper to drop.
CONFIG_IPV6=y

# requestStop (the power button) arrives as KEY_POWER from gpio-keys on a
# PL061 GPIO controller.
CONFIG_GPIOLIB=y
CONFIG_GPIO_PL061=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y

# Faster builds.
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_BTF=n
